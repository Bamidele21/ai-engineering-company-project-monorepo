# Supabase PostgreSQL connection string. Use the Transaction pooler URI
# (Supabase dashboard -> Connect -> Direct -> Transaction pooler -> URI).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# The Inventory API reuses the TinyDB JWT auth from Supply_directory_API, so it
# must share the same signing secret and expiry configuration. Never commit a
# real secret.
JWT_SECRET_KEY=replace-with-the-same-long-random-secret
JWT_EXPIRY_MINUTES=30

# Comma-separated browser origins allowed to call the API.
INVENTORY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Validating telemetry receiver used by server-origin business events.
TELEMETRY_ENDPOINT=http://localhost:8001/telemetry/events

# Reporting pipeline dispatch. Docker Compose overrides this value with
# http://prefect-server:4200/api inside the container network.
PREFECT_API_URL=http://localhost:4200/api
PREFECT_DEPLOYMENT_NAME=weekly-office-program-performance
