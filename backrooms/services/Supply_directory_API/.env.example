# Required for JWT signing. Use a long random value in deployed environments.
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Access token lifetime in minutes.
JWT_EXPIRY_MINUTES=30
# Comma-separated browser origins allowed to call the API.
SUPPLIERS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Resend transactional email credentials. RESEND_API_KEY is secret; never commit it.
RESEND_API_KEY=re_replace-with-your-resend-api-key
# Verified Resend sender. The sandbox sender only delivers to the account owner.
RESEND_FROM_EMAIL=Nexova <onboarding@resend.dev>
# Public frontend URL that renders the reset form. The reset token is appended as ?token=...
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# Password reset token lifetime in minutes (allowed range 15-60).
PASSWORD_RESET_EXPIRY_MINUTES=30
