# Worker-only configuration for data/pipelines.
# The repository-root .env supplies DATABASE_URL and the shared JWT secret.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
PREFECT_API_URL=http://localhost:4200/api
PREFECT_DEPLOYMENT_NAME=weekly-office-program-performance
PREFECT_WORK_POOL=nexova-data-pipelines
PREFECT_RESULTS_PERSIST_BY_DEFAULT=true
REPORTING_REJECTION_THRESHOLD=0.05
REPORTING_STALE_RUN_MINUTES=15
REPORTING_ALERTS_WEBHOOK=
REPORTING_SNAPSHOT_DIR=data/eval/weekly_performance
