# Root environment for the Nexova monorepo Docker Compose stack.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ===================== Shared backend auth config =====================
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRY_MINUTES=60
JWT_ALGORITHM=HS256

# ===================== Supply Directory API =====================
SUPPLIERS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Nexova <onboarding@resend.dev>
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRY_MINUTES=30

# ===================== Inventory API =====================
INVENTORY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ===================== Frontend (browser-facing) API URLs =====================
# These are resolved by the host browser via published Docker ports, so they use
# localhost. Container-to-container traffic (none today) would use service names:
# http://suppliers-api:8000 and http://inventory-api:8001.
NEXT_PUBLIC_SUPPLIERS_API_URL=http://localhost:8000
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8001
NEXT_PUBLIC_ANALYZER_API_URL=http://localhost:8000

# ===================== Telemetry =====================
# Browser batch target. Sprint 1 accepts and validates batches without persistence.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8001/telemetry/events
# Server-origin business events are batched to the same validating receiver.
TELEMETRY_ENDPOINT=http://localhost:8001/telemetry/events

# ===================== Reporting pipeline (Prefect) =====================
# Host-run API/worker value. Docker Compose overrides this with the
# container-to-container Prefect service URL.
PREFECT_API_URL=http://localhost:4200/api
PREFECT_DEPLOYMENT_NAME=weekly-office-program-performance
PREFECT_WORK_POOL=nexova-data-pipelines
REPORTING_REJECTION_THRESHOLD=0.05
REPORTING_STALE_RUN_MINUTES=15
# Optional webhook for the non-critical reporting alert subflow. Unset means
# alerts stay in logs and the pipeline_runs audit rows only.
REPORTING_ALERTS_WEBHOOK=
